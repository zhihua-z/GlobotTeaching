# FastAPI
APP_NAME=Globot Teaching API
DEBUG=true

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/globot_teaching
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/globot_teaching

# JWT
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:3000"]